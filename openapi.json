{
 "openapi": "3.1.0",
 "info": {
  "title": "Solana Agent Toolbox (x402)",
  "description": "Pay-per-call (x402, USDC on Solana, $0.005/call) Solana tools for AI agents: token safety, tx-error explainer, wallet snapshot. Unpaid calls to /v1/* return HTTP 402 with x402 v2 payment requirements.",
  "version": "1.0.0"
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Health",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     }
    }
   }
  },
  "/v1/token/{mint}": {
   "get": {
    "summary": "Token",
    "operationId": "token_v1_token__mint__get",
    "parameters": [
     {
      "name": "mint",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Mint"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/v1/tx/simulate": {
   "post": {
    "summary": "Tx Simulate",
    "operationId": "tx_simulate_v1_tx_simulate_post",
